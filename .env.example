# Copy this file to .env and change the password (in both places)
POSTGRES_USER=brushwise
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brushwise
DATABASE_URL="postgresql://brushwise:change_me@localhost:5434/brushwise"

# Generate your own, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3002"

# From your Vercel Blob store: Storage > your store > .env.local
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_your_token_here"

# AI feedback. AI_MODE=live calls Claude; anything else uses an example answer for free.
# Get a key at platform.claude.com. AI_MODEL is optional (default claude-opus-5-5).
AI_MODE="mock"
ANTHROPIC_API_KEY=""
# AI_MODEL="claude-opus-5-5"
