# Copy this file to .env and change the password (in both places)
POSTGRES_USER=brushwise
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brushwise
DATABASE_URL="postgresql://brushwise:change_me@localhost:5434/brushwise"

# Generate your own, for example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
