// Prisma schema for Brushwise.
// Models are added step by step, following PLAN.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Collection
// ---------------------------------------------------------------------------

enum PaintStatus {
  UNPAINTED
  IN_PROGRESS
  DONE
}

model Miniature {
  id        String      @id @default(cuid())
  name      String
  faction   String?
  status    PaintStatus @default(UNPAINTED)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Every miniature belongs to one user, and is deleted with that user
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photos Photo[]

  // The collection page lists one user's miniatures, newest first
  @@index([userId, createdAt])
}

// A photo of a miniature. The file itself lives in Vercel Blob; the database
// keeps its address. Who owns a photo is decided by its miniature.
model Photo {
  id          String   @id @default(cuid())
  url         String // Public address of the file in Vercel Blob
  pathname    String // The file's path inside the Blob store
  contentType String
  size        Int // In bytes
  createdAt   DateTime @default(now())

  miniatureId String
  miniature   Miniature @relation(fields: [miniatureId], references: [id], onDelete: Cascade)

  feedback Feedback?

  @@index([miniatureId, createdAt])
}

// AI feedback on one photo. The shape of `areas` and `nextSteps` is defined
// and validated by the Zod schema in src/lib/feedback.ts.
model Feedback {
  id           String   @id @default(cuid())
  overallScore Int // 1–10
  summary      String
  areas        Json // [{ area, score, comment, tip }]
  nextSteps    Json // ["...", "..."]
  model        String // Which model wrote it, or "mock"
  createdAt    DateTime @default(now())

  photoId String @unique
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  // Stored on the feedback itself so the daily limit is one simple count
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Auth tables used by Better Auth (users, sessions, accounts, verification)
// ---------------------------------------------------------------------------

model User {
  id            String      @id
  name          String
  email         String
  emailVerified Boolean     @default(false)
  image         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  miniatures    Miniature[]
  feedbacks     Feedback[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

// One row per way of signing in. With email and password, the hashed
// password lives here (providerId "credential"), never on the user.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
